  "Portal Occidente" -- "Centro" [label="16"];
  "Portal Occidente" -- "Portal Sur" [label="13"];
  "Aeropuerto" -- "Calle 72" [label="11"];
  "Museo" -- "Portal Sur" [label="10"];
  "Portal Norte" -- "Aeropuerto" [label="18"];
}
